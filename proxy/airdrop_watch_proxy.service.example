[Unit]
Description=Airdrop Watch Blockscout proxy (FlareSolverr)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/airdrop-watch/proxy
EnvironmentFile=/opt/airdrop-watch/proxy/.env
Environment=FLARESOLVERR_URL=http://127.0.0.1:8191/v1
ExecStartPre=-/usr/bin/docker start flaresolverr
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do curl -sf http://127.0.0.1:8191/health >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /opt/airdrop-watch/proxy/airdrop_watch_proxy.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
