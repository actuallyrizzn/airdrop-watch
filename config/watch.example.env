# Copy to config/watch.env (or export in the process environment).
# Never commit real secrets.

# Wallet to watch (0x…)
AW_WATCH_ADDRESS=0x0000000000000000000000000000000000000000

# bcrypt hash of the page password (generate with: php -r "echo password_hash('your-pass', PASSWORD_DEFAULT), PHP_EOL;")
AW_PASSWORD_HASH=

# Optional: seed tab before any drop (stand-in token while the real mint is pending)
AW_SEED_TOKEN=
AW_SEED_SYMBOL=DEMO
AW_SEED_LABEL=Stand-in token (not the real airdrop yet)
AW_AMM=both

# Optional explorer proxy when Blockscout is Cloudflare-blocked from the app host
AW_PROXY_URL=
AW_PROXY_KEY=

# Poll interval hint for the UI (ms). Server still answers on demand.
AW_POLL_MS=10000

# Path to chain JSON (default: ../config/chain.json relative to app/public)
# AW_CHAIN_FILE=
